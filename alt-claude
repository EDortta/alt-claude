show_profiles_group() {
  local wanted="$1" title="$2" found=0
  shopt -s nullglob
  echo
  echo "$title"
  printf '%-24s %-12s %-12s %-12s %s\n' "PROFILE" "STATUS" "CONTEXT" "SAFE" "MODEL"
  printf '%-24s %-12s %-12s %-12s %s\n' "------------------------" "------------" "------------" "------------" "---------------------------------------------"
  for f in "$PROFILE_DIR"/*.env; do
    unset MODEL STATUS CONTEXT_WINDOW SAFE_CONTEXT_TOKENS DISPLAY_NAME PRIVACY
    # shellcheck disable=SC1090
    source "$f"
    privacy="${PRIVACY:-review}"
    [[ "$privacy" == "$wanted" ]] || continue
    name="$(basename "$f" .env)"
    printf '%-24s %-12s %-12s %-12s %s\n' "$name" "${STATUS:-unknown}" "${CONTEXT_WINDOW:-N/D}" "${SAFE_CONTEXT_TOKENS:-N/D}" "${MODEL:-N/D}"
    found=1
  done
  (( found == 1 )) || echo "(nenhum perfil nesta classe)"
}

check_direct_provider_policy() {
  local provider="" prev=""
  for arg in "$@"; do
    if [[ "$prev" == "--use" || "$prev" == "--user" ]]; then provider="$arg"; break; fi
    case "$arg" in
      --use=*|--user=*) provider="${arg#*=}"; break ;;
    esac
    prev="$arg"
  done
  [[ -n "$provider" ]] || return 0
  [[ -f "$POLICY_BIN" || -x "$POLICY_BIN" ]] || return 0
  python3 "$POLICY_BIN" check --provider "$provider" --privacy sensitive_ok
}

case "${1:-}" in
  help)
    case "${2:-}" in
      "") usage_main ;;
      profiles) usage_profiles ;;
      compact) usage_compact ;;
      policy) usage_policy ;;
      providers|provider) usage_providers ;;
      keys|key|credentials|credenciais) usage_keys ;;
      *) echo "Assunto desconhecido: ${2}" >&2; echo >&2; usage_main; exit 2 ;;
    esac
    exit 0
    ;;
  --usage)
    [[ -f "$USAGE_BIN" || -x "$USAGE_BIN" ]] || { echo "Erro: relatório de uso não encontrado: $USAGE_BIN" >&2; exit 2; }
    exec python3 "$USAGE_BIN"
    ;;
  compact)
    shift
    [[ -f "$COMPACTOR" || -x "$COMPACTOR" ]] || { echo "Erro: compactador offline não encontrado: $COMPACTOR" >&2; exit 2; }
    exec python3 "$COMPACTOR" "$@"
    ;;
  policy)
    shift
    [[ -f "$POLICY_BIN" || -x "$POLICY_BIN" ]] || { echo "Erro: policy engine não encontrado: $POLICY_BIN" >&2; exit 2; }
    exec python3 "$POLICY_BIN" "$@"
    ;;
  profiles)
    if [[ "${2:-}" == "-h" || "${2:-}" == "--help" ]]; then usage_profiles; exit 0; fi
    show_profiles_group sensitive_ok "=== ADEQUADOS PARA PROJETOS SENSÍVEIS (verificados pelo alt-claude) ==="
    show_profiles_group review "=== REVISAR PRIVACIDADE ANTES DE USAR CÓDIGO SENSÍVEL ==="
    show_profiles_group public_only "=== NÃO USAR COM CÓDIGO SENSÍVEL / PRIVADO ==="
    echo
    echo "Classes: sensitive_ok = política verificada; review = termos/roteamento exigem revisão; public_only = bloqueie em projetos privados."
    exit 0
    ;;
  --profile)
    [[ $# -ge 2 ]] || { echo "Erro: --profile requer um nome" >&2; exit 2; }
    profile="$2"; shift 2
    exec "$PROFILE_BIN" "$profile" "$@"
    ;;
  --profile=*)
    profile="${1#*=}"; shift
    exec "$PROFILE_BIN" "$profile" "$@"
    ;;
  -h|--help|"")
    usage_main
    exit 0
    ;;
  *)
    check_direct_provider_policy "$@"
    exec "$CORE" "$@"
    ;;
esac
