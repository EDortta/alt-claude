#!/usr/bin/env bash
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CORE="${ALT_CLAUDE_CORE:-$SELF_DIR/alt-claude-core}"
PROFILE_BIN="${ALT_CLAUDE_PROFILE_BIN:-$SELF_DIR/alt-claude-profile}"
COMPACTOR="${ALT_CLAUDE_COMPACTOR:-$SELF_DIR/alt-claude-session-compact}"
POLICY_BIN="${ALT_CLAUDE_POLICY_BIN:-$SELF_DIR/alt-claude-policy}"
USAGE_BIN="${ALT_CLAUDE_USAGE_BIN:-$SELF_DIR/alt-claude-usage}"
MODEL_STATE="${ALT_CLAUDE_MODEL_STATE_BIN:-$SELF_DIR/alt-claude-model-state}"
PERFORMANCE_BIN="${ALT_CLAUDE_PERFORMANCE_BIN:-$SELF_DIR/alt-claude-performance}"
PROFILE_DIR="${ALT_CLAUDE_PROFILE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/alt-claude/profiles}"

[[ -f "$COMPACTOR" || -x "$COMPACTOR" ]] || COMPACTOR="$SELF_DIR/tools/session-compact.py"
[[ -f "$POLICY_BIN" || -x "$POLICY_BIN" ]] || POLICY_BIN="$SELF_DIR/tools/project-policy.py"
[[ -f "$USAGE_BIN" || -x "$USAGE_BIN" ]] || USAGE_BIN="$SELF_DIR/tools/usage-report.py"
[[ -f "$MODEL_STATE" || -x "$MODEL_STATE" ]] || MODEL_STATE="$SELF_DIR/tools/model-state.py"
[[ -f "$PERFORMANCE_BIN" || -x "$PERFORMANCE_BIN" ]] || PERFORMANCE_BIN="$SELF_DIR/tools/performance.py"
[[ -d "$SELF_DIR/profiles" ]] && PROFILE_DIR="$SELF_DIR/profiles"

usage_main() {
  cat <<'EOF'
alt-claude — Claude Code com providers/modelos alternativos

USO PRINCIPAL
  alt-claude --profile NAME [opções] [argumentos do Claude Code]
  alt-claude profiles
  alt-claude compact SESSION_ID [opções]
  alt-claude policy COMANDO [argumentos]
  alt-claude --use PROVIDER [opções] [argumentos do Claude Code]

ATALHOS
  alt-claude-<perfil> [opções]

  Os atalhos são compatibilidade/conveniência. Exemplo:
    alt-claude-north-mini-code --yolo
  equivale a:
    alt-claude --profile north-mini-code --yolo

OPÇÕES COMUNS
  --profile NAME           usa um perfil/modelo do catálogo
  --use PROVIDER           usa provider diretamente
  --model MODEL            sobrescreve o modelo no modo --use
  --yolo                   não pede aprovação para ações do Claude Code
                           (traduzido para --dangerously-skip-permissions)
  --resume ID              retoma uma sessão Claude Code existente
  --resume=ID              mesma coisa
  --usage                  relatório factual de autenticação/quota conhecida
  --last-model             último modelo usado neste projeto Git
  --evaluate N             avalia de 1 a 5 o último modelo deste projeto
  --disable MODEL          desabilita globalmente um modelo/perfil
  --enable MODEL           reabilita globalmente um modelo/perfil
  --disabled               lista modelos desabilitados
  --list-performance       testa e ranqueia perfis gratuitos habilitados
  --list                   lista providers do core
  -h, --help               esta ajuda

COMANDOS
  profiles                 lista perfis, separados por classe de privacidade
  compact SESSION_ID       cria handoff Markdown OFFLINE de uma sessão
  policy init standard     cria .alt-claude/config padrão no projeto
  policy init sensitive    cria política restritiva para código sensível
  policy show              mostra a política efetiva do projeto atual
  policy deny profile X    bloqueia um perfil neste projeto
  policy deny provider X   bloqueia um provider neste projeto
  policy allow profile X   libera explicitamente um perfil

USO / QUOTA
  alt-claude --usage NÃO chama "OK" de saldo disponível.
  Ele separa autenticação/configuração de quota conhecida. Quando o provider
  não expõe quota restante de forma confiável, mostra DESCONHECIDA.

  Para URLs oficiais de criação de chaves:
    alt-claude help keys

PRIVACIDADE DOS PERFIS
  sensitive_ok   adequado para projeto sensível segundo a política cadastrada
  review         revise termos/roteamento antes de usar código sensível
  public_only    NÃO usar com código privado ou sensível

  Veja a classificação atual com:
    alt-claude profiles

POLÍTICA POR PROJETO
  O arquivo é:
    <raiz-do-git>/.alt-claude/config

  Ele é declarativo e nunca é executado como shell.

  Exemplo para projeto sensível:
    alt-claude policy init sensitive
    alt-claude policy show

  Nesse modo, perfis que não sejam sensitive_ok são bloqueados ANTES da
  chamada ao provider, salvo uma liberação explícita do perfil.

CONTEXTO E COMPACTAÇÃO
  Cada perfil pode declarar janela de contexto, margem segura e percentual
  de auto-compactação. Ao usar --resume, alt-claude bloqueia sessões já acima
  da margem segura antes de enviar uma requisição que certamente falharia.

  Recuperação offline:
    alt-claude compact SESSION_ID

  Depois inicie uma sessão nova, por exemplo:
    alt-claude --profile north-mini-code --yolo \
      "Leia claude-handoff-SESSION_ID.md, confira o repositório e continue."

MODELOS GRATUITOS
  Perfis OpenRouter :free fazem um preflight mínimo. Se a rota gratuita não
  estiver disponível, alt-claude encerra com erro. Por padrão NÃO usa Codex,
  Copilot ou qualquer provider pago/por assinatura como substituto.

  Para autorizar deliberadamente fallback para providers já configurados:
    ALT_CLAUDE_ALLOW_FALLBACK=1 alt-claude --profile north-mini-code

  ALT_CLAUDE_NO_FALLBACK=1 continua aceito e tem precedência, para garantir
  comportamento fail-closed mesmo se ALLOW_FALLBACK estiver definido no shell.

EXEMPLOS
  alt-claude profiles
  alt-claude --profile north-mini-code --yolo
  alt-claude --profile north-mini-code --yolo --resume SESSION_ID
  alt-claude --profile nemotron --yolo
  alt-claude --use codex --yolo
  alt-claude --use copilot --resume SESSION_ID
  alt-claude --usage
  alt-claude --list-performance
  alt-claude --last-model
  alt-claude --evaluate 5
  alt-claude --disable north-mini-code
  alt-claude --enable north-mini-code
  alt-claude compact SESSION_ID
  alt-claude policy init sensitive

AJUDA POR ASSUNTO
  alt-claude help profiles
  alt-claude help performance
  alt-claude help compact
  alt-claude help policy
  alt-claude help providers
  alt-claude help keys
EOF
}

usage_profiles() {
  cat <<'EOF'
alt-claude profiles

Lista todos os perfis instalados e os separa em três blocos de privacidade:
  1. sensitive_ok
  2. review
  3. public_only

Também mostra status, janela de contexto, margem segura e model ID.

Use um perfil com:
  alt-claude --profile NAME --yolo

Os antigos comandos alt-claude-NAME continuam disponíveis como atalhos.
EOF
}

usage_performance() {
  cat <<'EOF'
alt-claude --list-performance [--json] [--timeout SEGUNDOS]

Executa um benchmark curto nos perfis gratuitos habilitados. Cada perfil recebe
um único prompt com três microtestes determinísticos: aritmética, leitura de
código e lógica. O ranking prioriza acertos e usa o menor tempo como desempate.

O benchmark não altera --last-model e não autoriza fallback para Codex/Copilot.

Exemplos:
  alt-claude --list-performance
  alt-claude --list-performance --timeout 60
  alt-claude --list-performance --json

O histórico é acumulado em:
  ~/.local/state/alt-claude/performance.jsonl
EOF
}

usage_compact() {
  cat <<'EOF'
alt-claude compact SESSION_ID [opções]

Lê a sessão Claude Code local (JSONL) e cria um handoff Markdown SEM chamar
qualquer LLM/API. Útil quando /compact já não cabe na janela do modelo.

Exemplos:
  alt-claude compact 1234-abcd
  alt-claude compact 1234-abcd -o handoff.md
  alt-claude compact 1234-abcd --turns 30

Para todas as opções:
  alt-claude compact --help
EOF
}

usage_policy() {
  cat <<'EOF'
alt-claude policy COMANDO [argumentos]

Política local de segurança por projeto. O arquivo fica em:
  <git-root>/.alt-claude/config

Comandos:
  alt-claude policy init standard
  alt-claude policy init sensitive
  alt-claude policy show
  alt-claude policy deny profile NAME
  alt-claude policy deny provider NAME
  alt-claude policy allow profile NAME

A política é aplicada antes de qualquer chamada ao modelo.
O arquivo config é somente dados; não é executado com source/eval.
EOF
}

